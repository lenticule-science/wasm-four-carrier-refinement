{
  "name": "@lenticule-science/wasm-four-carrier-refinement",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent no-import WebAssembly refinement assay for one-input/one-output FOUR circuit leaves.",
  "exports": {
    ".": "./src/refinement-assay.mjs",
    "./client": "./src/client.mjs"
  },
  "bin": {
    "serve-wasm-four-carrier-refinement-a2a": "./bin/server.mjs"
  },
  "scripts": {
    "check": "node --check src/refinement-assay.mjs && node --check src/client.mjs && node --check src/law.mjs && node --check bin/run-wasm-four.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.0",
    "@lenticule-science/infomaterial-observation": "2.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "wasm-four-carrier-refinement",
    "actor": "urn:ame:wasm-four-carrier-refinement",
    "organizational-kind": "micro-enterprise",
    "owners": [
      "obsmetrological-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one exact M1 leaf, producer smart account, canonical regular-file observation, and bounded no-import WebAssembly carrier",
    "refusal": "self-assay, material drift, non-file material, composite or wrong-arity component, imports, start section, ABI drift, partial vectors, behavior mismatch, customer mutation, label-only placement, or fallback profile",
    "operation-catalog": {
      "serve-wasm-four-carrier-refinement-a2a": {
        "contract": "ni:///sha-256;xVUs2-N5MiZmWFiIw7KT0mWXu7er3kzN0Rs8RCO4PAk",
        "protocol": "A2A 1.0",
        "accepts": "application/rmn+cbor WasmFourCarrierRefinementAssayRequest",
        "returns": "application/rmn+cbor CircuitCarrierRefinementReceipt|standard A2A refusal",
        "legacyCompatibility": false
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "lenticule-science",
    "kind": "actor",
    "actor": "urn:ame:wasm-four-carrier-refinement",
    "operations": [
      "serve-wasm-four-carrier-refinement-a2a"
    ],
    "capabilities": [
      {
        "capability": "wasm-four-carrier-refinement",
        "faces": [
          "serve-wasm-four-carrier-refinement-a2a"
        ]
      }
    ],
    "package": "@lenticule-science/wasm-four-carrier-refinement"
  }
}
